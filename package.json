{
	"name": "ktb-website",
	"private": true,
	"workspaces": [
		"apps/*",
		"infra/*"
	],
	"type": "module",
	"scripts": {
		"dev": "vp -C apps/landing dev --port 3001",
		"build": "vp -C apps/landing build",
		"preview": "vp -C apps/landing preview",
		"check": "vp check",
		"lint": "vp lint",
		"format": "vp fmt",
		"test": "vp test",
		"plan": "cuora run --config cuora.toml -- alchemy plan",
		"deploy": "cuora run --config cuora.toml -- alchemy deploy -y",
		"infra:dev": "alchemy dev",
		"infra:deploy": "cuora run --config cuora.toml -- alchemy deploy -y",
		"infra:destroy": "alchemy destroy"
	},
	"devDependencies": {
		"@alchemy.run/cloudflare": "2.0.0-beta.85",
		"@ktb/infra-cloudflare": "workspace:*",
		"@types/node": "^22.10.2",
		"alchemy": "2.0.0-beta.85",
		"effect": "4.1.2",
		"typescript": "^6.0.2",
		"vite-plus": "1.5.0",
		"vitest": "5.1.0"
	},
	"packageManager": "bun@1.4.4"
}
